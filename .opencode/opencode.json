{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/xiaomi/mimo-v2.5-pro@preset/default",
  "permission": "allow",
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-pro@preset/default": {},
        "minimax/minimax-m3@preset/default": {},
        "z-ai/glm-5.2@preset/default": {},
        "xiaomi/mimo-v2.5-pro@preset/default": {},
        "openrouter/auto@preset/default": {}
      }
    }
  },
  "mcp": {
    "d2cc": {
      "type": "local",
      "command": ["/home/codespace/nvm/current/bin/node", "/workspaces/d2cc/bin/d2cc.js", "mcp"],
      "enabled": true,
      "timeout": 15000,
      "cwd": "/workspaces/d2cc"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  }
}
