{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/minimax/minimax-m3@preset/default",
  "permission": "allow",
  "mcp": {
    "open-design": {
      "type": "local",
      "command": ["node", "/Applications/Open Design.app/Contents/Resources/app/prebundled/daemon/daemon-cli.mjs", "mcp", "--daemon-url", "http://127.0.0.1:7456"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-pro@preset/default": {},
        "minimax/minimax-m3@preset/default": {},
        "z-ai/glm-5.2@preset/default": {},
        "xiaomi/mimo-v2.5-pro@preset/default": {},
        "openrouter/auto@preset/default": {}
      }
    }
  }
}
