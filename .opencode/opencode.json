  "provider": {
    "openrouter": {
      "models": {
        "xiaomi/mimo-v2.5-pro@preset/default": {},
        "google/gemini-3.5-flash@preset/default": {},
        "openrouter/auto@preset/default": {}
      }
    }
  },
  "mcp": {
    "d2cc": {
      "type": "local",
      "command": ["node", "/workspaces/d2cc/bin/d2cc.js", "mcp"],
      "enabled": true
    }
  }
