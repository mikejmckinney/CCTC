{
  "name": "cctc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node -e \"const fs=require('node:fs'); const { spawnSync } = require('node:child_process'); if (fs.existsSync('scripts/validate.mjs')) { const result = spawnSync(process.execPath, ['scripts/validate.mjs'], { stdio: 'inherit' }); process.exit(result.status ?? 1); } console.log('scripts/validate.mjs not present yet; skipping validation.');\"",
    "validate:ci": "node scripts/validate.mjs --ci",
    "validate:coverage": "node scripts/validate.mjs --coverage-only",
    "validate:references": "node scripts/validate.mjs --references-only",
    "validate:strict": "node scripts/validate.mjs --strict",
    "reference:index": "node scripts/reference.mjs index",
    "reference:search": "node scripts/reference.mjs search",
    "reference:page": "node scripts/reference.mjs page",
    "reference:fetch-optn": "node scripts/reference/fetch-optn-policies.mjs",
    "reference:export-stubs": "node scripts/reference-export-stubs.mjs",
    "reference:audit-optn": "node scripts/reference-audit-optn.mjs",
    "validate:stubs": "node scripts/validate-stubs.mjs",
    "build": "npm run validate && tsc -b && vite build",
    "build:ci": "npm run validate:ci && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/lib/reference-index.test.mjs scripts/lib/verification-stubs.test.mjs scripts/lib/optn-drift-remediation.test.mjs scripts/validate/25-scenario-companions.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:smoke": "node scripts/run-resume-smoke.mjs",
    "test:e2e:playwright": "playwright test -c playwright.config.mjs",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
